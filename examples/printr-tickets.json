        "props": [{ "p": "payload" }],
        "repeat": "",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "{\"blocks\":[{\"type\":\"title\",\"text\":\"Alarm\"},{\"type\":\"text\",\"text\":\"Door opened at 14:32\"}]}",
        "payloadType": "json",
        "x": 150,
        "y": 60,
        "wires": [["printr-example-print"]]
    },
    {
        "id": "printr-example-print",
