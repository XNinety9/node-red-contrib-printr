{
  "name": "node-red-contrib-printr",
  "version": "0.2.0",
  "description": "Node-RED nodes for a Printr receipt printer (Epson TM-T88V): tickets, to-do lists, shopping, saved tickets, status",
  "keywords": [
    "node-red",
    "printr",
    "receipt",
    "printer",
    "escpos"
  ],
  "license": "Apache-2.0",
  "author": "X99",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XNinety9/node-red-contrib-printr.git"
  },
  "homepage": "https://github.com/XNinety9/node-red-contrib-printr#readme",
  "bugs": {
    "url": "https://github.com/XNinety9/node-red-contrib-printr/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "node-red": {
    "version": ">=3.0.0",
    "nodes": {
      "printr-config": "printr-config.js",
      "printr-print": "printr-print.js",
      "printr-todo": "printr-todo.js",
      "printr-shopping": "printr-shopping.js",
      "printr-preset": "printr-preset.js",
      "printr-status": "printr-status.js"
    }
  },
  "files": [
    "examples/",
    "lib/",
    "printr-*.js",
    "printr-*.html"
  ],
  "scripts": {
    "test": "node --test test/ticket.test.js test/api.test.js"
  }
}
